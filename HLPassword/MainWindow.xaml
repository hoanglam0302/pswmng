									<TextBox Name="UnlockOtpBox" Style="{StaticResource CustomTextBox}" Width="200" Height="40" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" Margin="0,0,10,0" ToolTip="Nhập mã mở khóa do Admin cấp"/>
									<Button Name="BtnUnlockAccount" Content="MỞ KHÓA" Style="{StaticResource CustomButton}" Width="120" Height="40" FontSize="14" Click="BtnUnlockAccount_Click"/>
								</StackPanel>

								<Button Name="BtnCheckUnlockStatus" Content="🔄 Kiểm tra trạng thái mở khóa" Style="{StaticResource TextOnlyButton}" FontSize="13" Margin="0,5,0,0" Click="BtnCheckUnlockStatus_Click"/>
							</StackPanel>
						</Grid>
				</Border>

				<TextBlock Grid.Row="3" Text="Chuột phải để tạo Thư mục / Nhóm  •  Nhấp đúp để mở  •  Kéo thả để di chuyển" Foreground="#77AADD" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.85"/>
			</Grid>

			<!-- PASSWORD PAGE -->
			<Grid Name="PasswordGrid" Visibility="Hidden" Margin="0,40,0,0">
				<Border Width="540" Background="#E60A1628" CornerRadius="20" BorderBrush="{StaticResource BorderGradient}" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,26">
					<Border.Effect>
						<DropShadowEffect BlurRadius="24" Color="#005BFF" Opacity="0.45"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Name="FolderTitle" FontSize="24" Foreground="White" FontWeight="Bold" Margin="0,0,0,18" TextWrapping="Wrap" TextAlignment="Center">
							<TextBlock.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#00A2FF" Opacity="0.5"/>
							</TextBlock.Effect>
						</TextBlock>

						<Grid Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Username" Foreground="#88CCFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox Name="UsernameBox" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}"/>
									<Button Grid.Column="1" Width="34" Height="40" Margin="4,0,0,0" ToolTip="Copy to Clipboard" Style="{StaticResource HoverCopyButton}" Click="CopyUsername_Click">
										<Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="#88CCFF" Width="16" Height="16" Stretch="Uniform"/>
									</Button>
								</Grid>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Account Type" Foreground="#88CCFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox Name="AccountTypeBox" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}"/>
									<Button Grid.Column="1" Width="34" Height="40" Margin="4,0,0,0" ToolTip="Copy to Clipboard" Style="{StaticResource HoverCopyButton}" Click="CopyAccountType_Click">
										<Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="#88CCFF" Width="16" Height="16" Stretch="Uniform"/>
									</Button>
								</Grid>
							</StackPanel>
						</Grid>

						<TextBlock Text="Password" Foreground="#88CCFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<Grid Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<PasswordBox Name="PasswordBoxHidden" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}" VerticalContentAlignment="Center"/>
							<TextBox Name="PasswordBoxVisible" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}" VerticalContentAlignment="Center" Visibility="Hidden"/>
							<Button Name="TogglePasswordButton" Grid.Column="1" Content="👁️" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Width="38" Height="40" Cursor="Hand" Click="TogglePassword_Click" Margin="4,0,0,0"/>
							<Button Grid.Column="2" Width="34" Height="40" Margin="2,0,0,0" ToolTip="Copy to Clipboard" Style="{StaticResource HoverCopyButton}" Click="CopyPassword_Click">
								<Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="#88CCFF" Width="16" Height="16" Stretch="Uniform"/>
							</Button>
						</Grid>

						<Grid Margin="0,0,0,24">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Phone" Foreground="#88CCFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox Name="PhoneBox" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}"/>
									<Button Grid.Column="1" Width="34" Height="40" Margin="4,0,0,0" ToolTip="Copy to Clipboard" Style="{StaticResource HoverCopyButton}" Click="CopyPhone_Click">
										<Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="#88CCFF" Width="16" Height="16" Stretch="Uniform"/>
									</Button>
								</Grid>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Email" Foreground="#88CCFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<PasswordBox Name="EmailBoxHidden" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}" VerticalContentAlignment="Center"/>
									<TextBox Name="EmailBoxVisible" Grid.Column="0" Height="40" Style="{StaticResource CustomTextBox}" VerticalContentAlignment="Center" Visibility="Hidden"/>
									<Button Name="ToggleEmailButton" Grid.Column="1" Content="👁️" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Width="38" Height="40" Cursor="Hand" Click="ToggleEmail_Click" Margin="4,0,0,0"/>
									<Button Grid.Column="2" Width="34" Height="40" Margin="2,0,0,0" ToolTip="Copy to Clipboard" Style="{StaticResource HoverCopyButton}" Click="CopyEmail_Click">
										<Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="#88CCFF" Width="16" Height="16" Stretch="Uniform"/>
									</Button>
								</Grid>
							</StackPanel>
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="14"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" Content="{DynamicResource T_BackFolderBtn}" Height="44" FontSize="15" Style="{StaticResource TextOnlyButton}" Click="Back_Click"/>
							<Button Grid.Column="2" Content="{DynamicResource T_SaveDataBtn}" Height="44" FontSize="15" Style="{StaticResource CustomButton}" Click="Save_Click"/>
						</Grid>
					</StackPanel>
				</Border>
			</Grid>

			<!-- VERSION INFO 2.2.19 beta -->
			<TextBlock Text="Ver 2.2.19 beta" Foreground="#88CCFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,15,15" Opacity="0.7" IsHitTestVisible="False"/>
		</Grid>
	</Border>
</Window>