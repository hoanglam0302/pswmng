<Window x:Class="HLPassword.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Copyright © 2026 by Vo Hoang Lam"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

	<Window.Resources>
		<!-- TỪ ĐIỂN ĐA NGÔN NGỮ -->
		<sys:String x:Key="T_LoginTitle">ĐĂNG NHẬP</sys:String>
		<sys:String x:Key="T_NoAccount">Chưa có tài khoản? Đăng ký</sys:String>
		<sys:String x:Key="T_RegTitle">ĐĂNG KÝ TÀI KHOẢN</sys:String>
		<sys:String x:Key="T_RegBtn">Đăng ký với Google</sys:String>
		<sys:String x:Key="T_BackLogin">⬅ Quay lại đăng nhập</sys:String>

		<sys:String x:Key="T_StorageTitle">Professional Data Storage</sys:String>
		<sys:String x:Key="T_StorageSub">Chào mừng bạn đến không gian quản lý và lưu trữ dữ liệu</sys:String>
		<sys:String x:Key="T_SaveDataBtn">Lưu dữ liệu</sys:String>
		<sys:String x:Key="T_BackFolderBtn">Quay lại thư mục</sys:String>

		<sys:String x:Key="T_MenuNotif">🔔 Thông báo</sys:String>
		<sys:String x:Key="T_MenuContact">✉️ Liên hệ Admin</sys:String>
		<sys:String x:Key="T_MenuLang">🌐 Ngôn ngữ</sys:String>
		<sys:String x:Key="T_MenuLogout">🚪 Đăng xuất</sys:String>

		<sys:String x:Key="T_CtxNewFolder">📄 Thư mục mới</sys:String>
		<sys:String x:Key="T_CtxNewGroup">📂 Nhóm mới</sys:String>
		<sys:String x:Key="T_CtxColor">🎨 Màu sắc</sys:String>
		<sys:String x:Key="T_CtxRename">✏️ Đổi tên</sys:String>
		<sys:String x:Key="T_CtxDelete">🗑️ Xóa</sys:String>

		<!-- BRUSHES VÀ STYLES -->
		<LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#0A1628" Offset="0"/>
			<GradientStop Color="#1A3A6B" Offset="0.3"/>
			<GradientStop Color="#005BFF" Offset="0.6"/>
			<GradientStop Color="#00A2FF" Offset="0.85"/>
			<GradientStop Color="#4DC9F6" Offset="1"/>
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="FolderFrameBackground" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#CC0A1628" Offset="0"/>
			<GradientStop Color="#CC102544" Offset="0.5"/>
			<GradientStop Color="#CC0A1A33" Offset="1"/>
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="FolderBorderGradient" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#664DC9F6" Offset="0"/>
			<GradientStop Color="#9900A2FF" Offset="0.5"/>
			<GradientStop Color="#66005BFF" Offset="1"/>
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#00D4FF" Offset="0"/>
			<GradientStop Color="#005BFF" Offset="0.5"/>
			<GradientStop Color="#001B44" Offset="1"/>
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="BorderGradient" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#00D4FF" Offset="0"/>
			<GradientStop Color="#4DC9F6" Offset="0.3"/>
			<GradientStop Color="#005BFF" Offset="0.7"/>
			<GradientStop Color="#001B44" Offset="1"/>
		</LinearGradientBrush>

		<!-- STYLE CHECKBOX CYBERPUNK -->
		<Style x:Key="CyberCheckBox" TargetType="CheckBox">
			<Setter Property="Background" Value="#1A2A4A"/>
			<Setter Property="BorderBrush" Value="#4DC9F6"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Grid VerticalAlignment="Center" Background="Transparent">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Border x:Name="Border" Width="22" Height="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
								<Path x:Name="CheckMark" Data="M 5,11 L 9,15 L 17,6" Stroke="#00D4FF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
							</Border>
							<ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
								<Setter TargetName="Border" Property="BorderBrush" Value="#00D4FF"/>
								<Setter TargetName="Border" Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="10" Color="#00D4FF" ShadowDepth="0" Opacity="0.8"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Border" Property="BorderBrush" Value="#00D4FF"/>
								<Setter TargetName="Border" Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="10" Color="#00D4FF" ShadowDepth="0" Opacity="0.5"/>
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="BottomLineProgressBar" TargetType="ProgressBar">
			<Setter Property="Background" Value="#1A2A4A"/>
			<Setter Property="Height" Value="3"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Grid>
							<Rectangle Fill="{TemplateBinding Background}"/>
							<Border x:Name="PART_Track">
								<Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left">
									<Rectangle.Fill>
										<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
											<GradientStop Color="#005BFF" Offset="0"/>
											<GradientStop Color="#00A2FF" Offset="0.6"/>
											<GradientStop Color="#4DC9F6" Offset="0.9"/>
											<GradientStop Color="#FFFFFF" Offset="1"/>
										</LinearGradientBrush>
									</Rectangle.Fill>
									<Rectangle.Effect>
										<DropShadowEffect Color="#00D4FF" BlurRadius="12" ShadowDepth="0"/>
									</Rectangle.Effect>
								</Rectangle>
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="ContextMenu">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Grid.IsSharedSizeScope" Value="True"/>
			<Setter Property="HasDropShadow" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContextMenu">
						<Border Background="#F20A1628" BorderThickness="1.5" CornerRadius="10" Padding="5" Margin="0,0,15,15" BorderBrush="#4DC9F6">
							<Border.Effect>
								<DropShadowEffect BlurRadius="15" Color="#00A2FF" Opacity="0.6" ShadowDepth="5" Direction="315"/>
							</Border.Effect>
							<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="MenuItem">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="MenuItem">
						<Border x:Name="Border" Background="Transparent" CornerRadius="6" BorderThickness="0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
									<ColumnDefinition Width="18"/>
								</Grid.ColumnDefinitions>
								<ContentPresenter x:Name="Icon" Margin="5,0,5,0" VerticalAlignment="Center" ContentSource="Icon"/>
								<ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
								<TextBlock x:Name="InputGestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#88CCFF"/>
								<Path x:Name="RightArrow" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 5,4 L 0,8 Z" Fill="#4DC9F6" Visibility="Hidden"/>

								<Popup x:Name="SubMenuPopup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
									<Border Background="#F20A1628" BorderThickness="1.5" BorderBrush="#4DC9F6" CornerRadius="10" Padding="5" Margin="0,0,15,15">
										<Border.Effect>
											<DropShadowEffect BlurRadius="15" Color="#00A2FF" Opacity="0.6" ShadowDepth="5" Direction="315"/>
										</Border.Effect>
										<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
									</Border>
								</Popup>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="Role" Value="SubmenuHeader">
								<Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#1A3A6B"/>
								<Setter Property="Foreground" Value="#00D4FF"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="#666666"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="Separator">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Margin" Value="5,4"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Separator">
						<Border BorderBrush="#334DC9F6" BorderThickness="1"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PopupMenuItem" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="#1A3A6B"/>
								<Setter Property="Foreground" Value="#00D4FF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PopupMenuLogoutItem" TargetType="Button">
			<Setter Property="Background" Value="#CCFF3333"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="#FF1A1A"/>
								<Setter Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="10" Color="#FF4D4D" ShadowDepth="0"/>
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="ContactTextBox" TargetType="TextBox">
			<Setter Property="Background" Value="#1A2A4A"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#4DC9F6"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SettingsGearButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#4DC9F6" Opacity="1"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="CustomButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource BorderGradient}" RenderTransformOrigin="0.5,0.5">
							<Border.RenderTransform>
								<ScaleTransform/>
							</Border.RenderTransform>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Border" Property="Opacity" Value="0.8"/>
								<Setter TargetName="Border" Property="RenderTransform">
									<Setter.Value>
										<ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Border" Property="Opacity" Value="0.7"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Border" Property="Background" Value="#334DC9F6"/>
								<Setter TargetName="Border" Property="BorderBrush" Value="#1A2A4A"/>
								<Setter Property="Foreground" Value="#88CCFF"/>
								<Setter Property="Cursor" Value="No"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TextOnlyButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#88CCFF"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="#FFFFFF"/>
								<Setter Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#4DC9F6" Opacity="0.8"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="CustomTextBox" TargetType="Control">
			<Setter Property="Background" Value="#1A2A4A"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderGradient}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Control">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
							<ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#4DC9F6"/>
								<Setter Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="HoverCopyButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#4DC9F6"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
					<Setter Property="Opacity" Value="1"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<ContextMenu x:Key="RootMenu">
			<MenuItem Header="{DynamicResource T_CtxNewFolder}" Click="MenuCreateDataFolderRoot_Click"/>
			<MenuItem Header="{DynamicResource T_CtxNewGroup}" Click="MenuCreateGroupFolderRoot_Click"/>
		</ContextMenu>

		<ContextMenu x:Key="GroupMenu">
			<MenuItem Header="{DynamicResource T_CtxNewFolder}" Click="MenuCreateDataFolderChild_Click"/>
			<Separator/>
			<MenuItem Header="{DynamicResource T_CtxColor}">
				<MenuItem Header="Mặc định" Tag="" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Đỏ" Tag="#FF4D4D" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Cam" Tag="#FFA64D" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Vàng" Tag="#E6B800" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Xanh lá" Tag="#009933" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Xanh dương" Tag="#005BFF" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Tím" Tag="#8A2BE2" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Hồng" Tag="#FF1493" Click="MenuChangeColor_Click"/>
			</MenuItem>
			<MenuItem Header="{DynamicResource T_CtxRename}" Click="MenuRename_Click"/>
			<MenuItem Header="{DynamicResource T_CtxDelete}" Click="MenuDelete_Click" Foreground="#FF4D4D"/>
		</ContextMenu>

		<ContextMenu x:Key="DataMenu">
			<MenuItem Header="{DynamicResource T_CtxColor}">
				<MenuItem Header="Mặc định" Tag="" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Đỏ" Tag="#FF4D4D" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Cam" Tag="#FFA64D" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Vàng" Tag="#E6B800" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Xanh lá" Tag="#009933" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Xanh dương" Tag="#005BFF" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Tím" Tag="#8A2BE2" Click="MenuChangeColor_Click"/>
				<MenuItem Header="Hồng" Tag="#FF1493" Click="MenuChangeColor_Click"/>
			</MenuItem>
			<MenuItem Header="{DynamicResource T_CtxRename}" Click="MenuRename_Click"/>
			<MenuItem Header="{DynamicResource T_CtxDelete}" Click="MenuDelete_Click" Foreground="#FF4D4D"/>
		</ContextMenu>
	</Window.Resources>

	<Border Background="{StaticResource MainBackground}" CornerRadius="20" Margin="10" BorderThickness="3" BorderBrush="{StaticResource BorderGradient}">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#005BFF" Opacity="0.5"/>
		</Border.Effect>

		<Grid>
			<!-- Background Animations -->
			<Canvas Name="BgAnimationCanvas" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
				<Canvas.Resources>
					<Storyboard x:Key="FloatingAnimation">
						<DoubleAnimation Storyboard.TargetName="Trans1" Storyboard.TargetProperty="X" From="-850" To="1200" Duration="0:0:22" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans2" Storyboard.TargetProperty="X" From="-500" To="1200" Duration="0:0:30" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans3" Storyboard.TargetProperty="X" From="-400" To="1200" Duration="0:0:25" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans4" Storyboard.TargetProperty="X" From="-300" To="1200" Duration="0:0:35" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans1" Storyboard.TargetProperty="Y" From="-25" To="25" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans2" Storyboard.TargetProperty="Y" From="0" To="-60" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans3" Storyboard.TargetProperty="Y" From="0" To="40" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever" />
						<DoubleAnimation Storyboard.TargetName="Trans4" Storyboard.TargetProperty="Y" From="0" To="-30" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever" />
					</Storyboard>
				</Canvas.Resources>
				<Ellipse Width="450" Height="450" Canvas.Top="-100">
					<Ellipse.Fill>
						<RadialGradientBrush>
							<GradientStop Color="#88005BFF" Offset="0"/>
							<GradientStop Color="#00005BFF" Offset="1"/>
						</RadialGradientBrush>
					</Ellipse.Fill>
					<Ellipse.RenderTransform>
						<TranslateTransform x:Name="Trans2" X="-500"/>
					</Ellipse.RenderTransform>
