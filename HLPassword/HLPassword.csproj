<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupabaseProjectUrl Condition="'$(SupabaseProjectUrl)' == ''">$(HLPASSWORD_SUPABASE_URL)</SupabaseProjectUrl>
    <SupabasePublishableKey Condition="'$(SupabasePublishableKey)' == ''">$(HLPASSWORD_SUPABASE_PUBLISHABLE_KEY)</SupabasePublishableKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SupabaseProjectUrl</_Parameter1>
      <_Parameter2>$(SupabaseProjectUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SupabasePublishableKey</_Parameter1>
      <_Parameter2>$(SupabasePublishableKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateSupabaseSingleFilePublish" BeforeTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(SupabaseProjectUrl)' == ''" Text="Set HLPASSWORD_SUPABASE_URL before publishing the single-file app." />
    <Error Condition="'$(SupabasePublishableKey)' == ''" Text="Set HLPASSWORD_SUPABASE_PUBLISHABLE_KEY before publishing." />
    <Error Condition="!$([System.String]::Copy('$(SupabasePublishableKey)').StartsWith('sb_publishable_'))" Text="Single-file releases require an sb_publishable_ key. Never embed an anon JWT, service-role key, or secret key in the desktop app." />
  </Target>

  <ItemGroup>
    <None Remove="Email.png" />
    <None Remove="FBLG.png" />
    <None Remove="HL.png" />
    <None Remove="HL1.png" />
    <None Remove="Zalo.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Email.png" />
    <Resource Include="FBLG.png" />
    <Resource Include="HL1.png" />
    <Resource Include="Zalo.png" />
  </ItemGroup>

</Project>
